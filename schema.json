  /api-v1/restaurants/operational-hours/batch/:
    post:
      operationId: restaurant_operational_hours_batch_upsert
      description: Batch upsert operational hours for the authenticated restaurant.
        Use closed=true to remove a day.
      tags:
      - api-v1
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/OperationalHoursBatchUpsert'
            examples:
              UpsertFullWeek:
                value:
                  days:
                  - day_of_week: Monday
                    open_time: 09:00:00
                    close_time: '17:00:00'
                  - day_of_week: Tuesday
                    open_time: 09:00:00
                    close_time: '17:00:00'
                  - day_of_week: Wednesday
                    open_time: 09:00:00
                    close_time: '17:00:00'
                  - day_of_week: Thursday
                    open_time: 09:00:00
                    close_time: '17:00:00'
                  - day_of_week: Friday
                    open_time: 09:00:00
                    close_time: '17:00:00'
                  - day_of_week: Saturday
                    open_time: '10:00:00'
                    close_time: '14:00:00'
                  - day_of_week: Sunday
                    closed: true
                summary: Upsert Full Week
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/OperationalHoursBatchUpsert'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/OperationalHoursBatchUpsert'
        required: true
      security:
      - knoxApiToken: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/OperationalHours'
              examples:
                UpsertFullWeek:
                  value:
                  - days:
                    - day_of_week: Monday
                      open_time: 09:00:00
                      close_time: '17:00:00'
                    - day_of_week: Tuesday
                      open_time: 09:00:00
                      close_time: '17:00:00'
                    - day_of_week: Wednesday
                      open_time: 09:00:00
                      close_time: '17:00:00'
                    - day_of_week: Thursday
                      open_time: 09:00:00
                      close_time: '17:00:00'
                    - day_of_week: Friday
                      open_time: 09:00:00
                      close_time: '17:00:00'
                    - day_of_week: Saturday
                      open_time: '10:00:00'
                      close_time: '14:00:00'
                    - day_of_week: Sunday
                      closed: true
                  summary: Upsert Full Week
          description: ''

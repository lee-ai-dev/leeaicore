openapi: 3.0.3
info:
  title: LEE AI API
  version: 1.0.0
  description: LEE AI CORE API
paths:
  /api-v1/admin/analytics/:
    get:
      operationId: admin_analytics
      description: 'Platform-wide analytics summary for admins: revenue, volumes,
        top vendors, and channel distribution.'
      tags:
      - api-v1
      security:
      - knoxApiToken: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: object
                additionalProperties: {}
              examples:
                AdminAnalyticsExample:
                  value:
                    summary:
                      active_restaurants: 12
                      total_revenue: '12345.67'
                      total_customers: 340
                      total_bookings: 210
                      total_orders: 580
                      active_subscriptions: 9
                      pending_refund_requests: 3
                      total_users: 150
                      total_reservations: 220
                    volumes_this_week:
                    - day: '2025-12-01'
                      weekday: Mon
                      orders: 25
                      reservations: 10
                    - day: '2025-12-02'
                      weekday: Tue
                      orders: 30
                      reservations: 8
                    top_vendors:
                    - id: 1
                      vendor_name: Pizza Palace
                      revenue: '4500.00'
                    - id: 2
                      vendor_name: Sushi Corner
                      revenue: '3200.00'
                    channels:
                      whatsapp: 45
                      web: 25
                      Instagram: 10
                      Messenger: 5
                      other: 15
          description: ''
  /api-v1/admin/dishes/:
    get:
      operationId: admin_dishes_list
      description: List all dishes in the system (admin only).
      tags:
      - api-v1
      security:
      - knoxApiToken: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/Dish'
          description: ''
  /api-v1/admin/orders/:
    get:
      operationId: admin_orders_list
      description: List all orders in the system (admin only).
      parameters:
      - in: query
        name: payment_status
        schema:
          type: string
      - in: query
        name: q
        schema:
          type: string
        description: Search by ord_id
      - in: query
        name: status
        schema:
          type: string
      tags:
      - api-v1
      security:
      - knoxApiToken: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/Order'
          description: ''
  /api-v1/admin/payments/:
    get:
      operationId: admin_payments_list
      description: List all payments in the system (admin only) with summary info.
      parameters:
      - in: query
        name: status
        schema:
          type: string
      tags:
      - api-v1
      security:
      - knoxApiToken: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/Payment'
          description: ''
  /api-v1/admin/reservations/:
    get:
      operationId: admin_reservations_list
      description: List all reservations in the system (admin only).
      parameters:
      - in: query
        name: status
        schema:
          type: string
      tags:
      - api-v1
      security:
      - knoxApiToken: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/Reservation'
          description: ''
  /api-v1/admin/restaurants/:
    get:
      operationId: admin_restaurants_list
      description: List all restaurants (admin only), including owner user info and
        latest subscription.
      tags:
      - api-v1
      security:
      - knoxApiToken: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/AdminRestaurantList'
          description: ''
  /api-v1/admin/restaurants/{id}/:
    get:
      operationId: admin_restaurant_detail
      description: Retrieve detailed information for a single restaurant (admin only).
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        required: true
      tags:
      - api-v1
      security:
      - knoxApiToken: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/RestaurantProfile'
          description: ''
    delete:
      operationId: admin_restaurant_delete
      description: Soft delete a restaurant by marking its owner inactive and deleted.
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        required: true
      tags:
      - api-v1
      security:
      - knoxApiToken: []
      responses:
        '200':
          content:
            application/json:
              schema:
                message: Restaurant deleted (soft) and user access revoked
          description: ''
  /api-v1/admin/restaurants/{id}/payments/:
    get:
      operationId: admin_restaurant_payments
      description: List all payments associated with a given restaurant (admin only).
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        required: true
      tags:
      - api-v1
      security:
      - knoxApiToken: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/Payment'
          description: ''
  /api-v1/admin/restaurants/{id}/subscriptions/:
    get:
      operationId: admin_restaurant_subscriptions
      description: List subscriptions for a restaurant (admin only), with a billing
        summary.
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        required: true
      tags:
      - api-v1
      security:
      - knoxApiToken: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: object
                additionalProperties: {}
              examples:
                AdminRestaurantSubscriptionsExample:
                  value:
                    summary:
                      next_billing_date: '2025-12-31'
                      monthly_amount: '199.99'
                      outstanding_balance: '80.00'
                      last_payment:
                        amount: '199.99'
                        currency: GHC
                        transaction_reference: sub_42_3_ABC123
                        start_date: '2025-12-01'
                        end_date: '2025-12-31'
                        status: ACTIVE
                    results:
                    - name: Pro Plan
                      start_date: '2025-12-01'
                      end_date: '2025-12-31'
                      transaction_reference: sub_42_3_ABC123
                      amount: '199.99'
                      currency: GHC
                      payment_status: ACTIVE
          description: ''
  /api-v1/admin/restaurants/{id}/suspend/:
    post:
      operationId: admin_restaurant_suspend
      description: Suspend a restaurant by disabling its owner user and revoking tokens.
        Expects a JSON body with "reason".
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        required: true
      tags:
      - api-v1
      requestBody:
        content:
          application/json:
            schema:
              type: object
              additionalProperties: {}
          application/x-www-form-urlencoded:
            schema:
              type: object
              additionalProperties: {}
          multipart/form-data:
            schema:
              type: object
              additionalProperties: {}
      security:
      - knoxApiToken: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: object
                additionalProperties: {}
          description: ''
  /api-v1/admin/restaurants/{id}/unsuspend/:
    post:
      operationId: admin_restaurant_unsuspend
      description: Unsuspend a restaurant by re-enabling its owner user (if not deleted).
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        required: true
      tags:
      - api-v1
      security:
      - knoxApiToken: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: object
                additionalProperties: {}
          description: ''
  /api-v1/admin/restaurants/{id}/users/:
    get:
      operationId: admin_restaurant_users
      description: List users associated with the restaurant (owner user for now).
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        required: true
      tags:
      - api-v1
      security:
      - knoxApiToken: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/AdminRestaurantUser'
          description: ''
  /api-v1/admin/tables/:
    get:
      operationId: admin_tables_list
      description: List all tables in the system (admin only).
      tags:
      - api-v1
      security:
      - knoxApiToken: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/Table'
          description: ''
  /api-v1/admin/users/:
    get:
      operationId: admin_list_users
      description: List users (admin/staff only). Supports optional 'q' search across
        name, email, phone.
      parameters:
      - in: query
        name: q
        schema:
          type: string
        description: Search by name, email or phone
      tags:
      - api-v1
      security:
      - knoxApiToken: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/User'
          description: ''
  /api-v1/admin/verifyuser/:
    post:
      operationId: admin_verify_user
      description: Set admin verification status for a user by id. Staff-only.
      tags:
      - api-v1
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/AdminVerifyUser'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/AdminVerifyUser'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/AdminVerifyUser'
        required: true
      security:
      - knoxApiToken: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/User'
          description: ''
        '400':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/GenericMessage'
          description: ''
        '401':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/GenericMessage'
          description: ''
        '403':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/GenericMessage'
          description: ''
        '404':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/GenericMessage'
          description: ''
  /api-v1/adminlogin/:
    post:
      operationId: admin_login
      description: Admin/Staff-only login endpoint (same as LoginAPI but enforces
        staff/admin).
      tags:
      - api-v1
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/Login'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/Login'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/Login'
        required: true
      security:
      - knoxApiToken: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/LoginResponse'
          description: ''
        '401':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/GenericMessage'
          description: ''
        '403':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/GenericMessage'
          description: ''
  /api-v1/changepassword/:
    post:
      operationId: change_password
      description: Change user password
      tags:
      - api-v1
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/ChangePassword'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/ChangePassword'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/ChangePassword'
        required: true
      security:
      - knoxApiToken: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/SimpleStatus'
          description: ''
        '400':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/GenericMessage'
          description: ''
  /api-v1/chatbot/intent/:
    post:
      operationId: chatbot_intent
      description: Classify user message with OpenAI into intents and return extracted
        entities.
      parameters:
      - in: query
        name: message
        schema:
          type: string
        required: true
      tags:
      - api-v1
      security:
      - knoxApiToken: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                type: object
                additionalProperties: {}
          description: ''
  /api-v1/complaints/:
    post:
      operationId: submit_complaint
      tags:
      - api-v1
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/Complaint'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/Complaint'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/Complaint'
        required: true
      security:
      - knoxApiToken: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Complaint'
          description: ''
  /api-v1/login/:
    post:
      operationId: login
      description: Login api endpoint
      tags:
      - api-v1
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/Login'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/Login'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/Login'
        required: true
      security:
      - knoxApiToken: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/LoginResponse'
          description: ''
        '401':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/GenericMessage'
          description: ''
  /api-v1/logout/:
    post:
      operationId: logout
      description: Logout user by invalidating their Knox token(s).
      tags:
      - api-v1
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/SimpleStatus'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/SimpleStatus'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/SimpleStatus'
        required: true
      security:
      - knoxApiToken: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/SimpleStatus'
          description: ''
  /api-v1/menu/:
    get:
      operationId: retrieve_menu
      description: Retrieve the menu. Filter by restaurant_rid or search by name/description.
      parameters:
      - in: query
        name: q
        schema:
          type: string
      - in: query
        name: restaurant_rid
        schema:
          type: string
      tags:
      - api-v1
      security:
      - knoxApiToken: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/Dish'
          description: ''
  /api-v1/orders/{ord_id}/status/:
    get:
      operationId: check_order_status
      parameters:
      - in: path
        name: ord_id
        schema:
          type: string
        required: true
      tags:
      - api-v1
      security:
      - knoxApiToken: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Order'
          description: ''
  /api-v1/orders/place/:
    post:
      operationId: place_order
      tags:
      - api-v1
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PlaceOrder'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PlaceOrder'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PlaceOrder'
        required: true
      security:
      - knoxApiToken: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Order'
          description: ''
  /api-v1/otplogin/:
    post:
      operationId: otp_login
      description: Login api endpoint using OTP
      tags:
      - api-v1
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/VerifyOTPPostRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/VerifyOTPPostRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/VerifyOTPPostRequest'
        required: true
      security:
      - knoxApiToken: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/LoginResponse'
          description: ''
        '401':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/GenericMessage'
          description: ''
  /api-v1/payments/{ord_id}/confirm/:
    post:
      operationId: payment_confirm
      parameters:
      - in: path
        name: ord_id
        schema:
          type: string
        required: true
      tags:
      - api-v1
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PaymentConfirm'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PaymentConfirm'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PaymentConfirm'
        required: true
      security:
      - knoxApiToken: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Payment'
          description: ''
  /api-v1/payments/banks/:
    get:
      operationId: list_banks
      description: Return a list of banks supported by the configured provider (Paystack).
      parameters:
      - in: query
        name: country
        schema:
          type: string
        description: Filter banks by country (provider-dependent).
      - in: query
        name: currency
        schema:
          type: string
        description: Filter banks by currency (e.g. NGN, GHS).
      tags:
      - api-v1
      security:
      - knoxApiToken: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/BanksListResponse'
              examples:
                BanksList(Paystack):
                  value:
                    provider: PAYSTACK
                    banks:
                    - name: Access Bank
                      slug: access-bank
                      code: '044'
                      longcode: 044150149
                      gateway: emandate
                      pay_with_bank: true
                      active: true
                      country: Nigeria
                      currency: NGN
                      type: nuban
                  summary: Banks List (Paystack)
          description: ''
  /api-v1/payments/intent/:
    post:
      operationId: payment_intent
      tags:
      - api-v1
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PaymentIntent'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PaymentIntent'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PaymentIntent'
        required: true
      security:
      - knoxApiToken: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Payment'
          description: ''
  /api-v1/payments/paystack/webhook/:
    post:
      operationId: paystack_webhook
      description: Paystack webhook endpoint to process payment and subscription events.
      tags:
      - api-v1
      security:
      - knoxApiToken: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                type: object
                additionalProperties: {}
          description: ''
  /api-v1/payments/refund/:
    post:
      operationId: payment_refund
      description: Issue a refund for a successful payment. Only admins/staff may
        refund payments.
      tags:
      - api-v1
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PaymentRefund'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PaymentRefund'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PaymentRefund'
        required: true
      security:
      - knoxApiToken: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaymentRefund'
          description: ''
  /api-v1/register/:
    post:
      operationId: register
      description: Register User api endpoint
      tags:
      - api-v1
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/RegisterUser'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/RegisterUser'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/RegisterUser'
        required: true
      security:
      - knoxApiToken: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/RegisterUserResponse'
          description: ''
        '401':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/GenericMessage'
          description: ''
  /api-v1/reservations/:
    get:
      operationId: list_reservations
      tags:
      - api-v1
      security:
      - knoxApiToken: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/ReadonlyReservation'
          description: ''
    post:
      operationId: create_reservation
      tags:
      - api-v1
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/Reservation'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/Reservation'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/Reservation'
        required: true
      security:
      - knoxApiToken: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Reservation'
          description: ''
  /api-v1/resetpassword/:
    post:
      operationId: reset_password
      description: Reset user password
      tags:
      - api-v1
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/ResetPassword'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/ResetPassword'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/ResetPassword'
        required: true
      security:
      - knoxApiToken: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/SimpleStatus'
          description: ''
        '400':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/GenericMessage'
          description: ''
  /api-v1/restaurants/create/:
    post:
      operationId: create_restaurant
      tags:
      - api-v1
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/RestaurantCreate'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/RestaurantCreate'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/RestaurantCreate'
        required: true
      security:
      - knoxApiToken: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/RestaurantProfile'
